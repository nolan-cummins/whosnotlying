{
  "name": "whosnotlying",
  "version": "0.2.0",
  "description": "Who's Not Lying? A party game of one truth and many bluffs. Self-hosted server: one Node process, no database, no build step.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/main.ts",
    "serve": "node deployment/web_server.ts",
    "test": "tsc --noEmit && node --test \"tests/*.test.ts\"",
    "check": "tsc --noEmit",
    "lint:packs": "node scripts/lint_packs.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  }
}
