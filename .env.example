# Copy to .env next to docker-compose.yml.
ADMIN_USER=admin
ADMIN_PASS=change-me
# Where players reach the game (goes into the QR code). Leave empty on a LAN: the host's IP is used.
PUBLIC_URL=
# Port on the host machine.
PORT=5050
# Optional Ollama server for topic matching by expertise and résumé parsing (see README).
OLLAMA_URL=
